# Variables del despliegue con Docker. Copie este archivo como «.env» (junto a docker-compose.yml) y complételo.

# Contraseña de la base de datos (inventela; solo la usa la API).
DB_PASSWORD=

# Cadena aleatoria de 32 caracteres o más. Genere una con:
#   openssl rand -hex 32
JWT_SECRET=

# Dirección con la que se abre la página, tal como la escribe el navegador, SIN «/» al final.
# En el servidor de pruebas: http://<IP-del-servidor>:8080   ·   en producción: https://editorial.unicesmag.edu.co
FRONTEND_URL=http://localhost:8080
API_PUBLICA_URL=http://localhost:8080

# Correos: simulado (no sale nada, para demostrar), brevo (envío real, ver el README) o apagado.
CORREO_MODO=simulado
BREVO_API_KEY=
BREVO_WEBHOOK_TOKEN=
# Correo desde el que salen los enlaces de contraseña (si se deja vacío, el de la primera revista).
REMITENTE_CUENTAS=

# En simulado, la página muestra el enlace de contraseña para abrirlo en la demostración. En producción: false.
ENLACE_DEMO=true
ZONA_HORARIA=America/Bogota
