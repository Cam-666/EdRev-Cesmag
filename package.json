{
  "name": "edrev-cesmag-raiz",
  "private": true,
  "description": "Repository root. Frontend in 'EdRev f', backend in 'EdRev b'; these scripts forward to them.",
  "scripts": {
    "install:frontend": "npm --prefix \"EdRev f\" install",
    "dev": "npm --prefix \"EdRev f\" run dev",
    "build": "npm --prefix \"EdRev f\" run build",
    "typecheck": "npm --prefix \"EdRev f\" run typecheck",
    "lint": "npm --prefix \"EdRev f\" run lint",
    "format": "npm --prefix \"EdRev f\" run format",
    "test": "npm --prefix \"EdRev f\" run test",
    "install:backend": "npm --prefix \"EdRev b\" install",
    "dev:backend": "npm --prefix \"EdRev b\" run dev",
    "db:crear": "npm --prefix \"EdRev b\" run db:crear",
    "db:init": "npm --prefix \"EdRev b\" run db:init"
  }
}
