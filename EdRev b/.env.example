# Copie este archivo como .env y ajuste los valores (nada de esto va en el código).

# Servidor
PORT=3000
# Origen del frontend permitido por CORS (separe varios con coma)
CORS_ORIGIN=http://localhost:5173

# Base de datos PostgreSQL. Cambie CLAVE por la contraseña del usuario postgres de su instalación.
DATABASE_URL=postgres://postgres:CLAVE@localhost:5432/edrev
# Base de mantenimiento para crear la anterior con «npm run db:crear»
DATABASE_ADMIN_URL=postgres://postgres:CLAVE@localhost:5432/postgres

# Sesión: firma de los tokens y duración (la página además la cierra tras 30 minutos de inactividad)
# Cadena aleatoria de al menos 32 caracteres (el servidor no arranca con una más corta ni con el texto de ejemplo).
# Genere una con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_HORAS=8
# Zona horaria de la dependencia (para la fecha de «hoy» en las entregas)
# ZONA_HORARIA=America/Bogota

# Valores del proceso
UMBRAL_COINCIDENCIAS=15
# Admite decimales para demostrar el segundo intento (0.002 ≈ 3 minutos)
# Solo se usa mientras no se guarde el valor en Administración › Configuración
DIAS_ESPERA_RESPUESTA=5
INTENTOS_ANTES_BLOQUEO=2
MAX_PARES_POR_ARTICULO=3

# Envío de correos: brevo (real, requiere BREVO_API_KEY y remitentes verificados en Brevo),
# simulado (para demostrar: se marcan enviados sin salir) o apagado (quedan en cola)
CORREO_MODO=simulado
BREVO_API_KEY=
# Token secreto del webhook de Brevo (rebotes): /api/webhooks/brevo?token=...
BREVO_WEBHOOK_TOKEN=
# Mientras no haya correo real, la API devuelve el enlace de contraseña para abrirlo en la demo
ENLACE_DEMO=true
# Reintentos automáticos de un correo que el servicio falló y minutos entre ellos
REINTENTOS_CORREO=3
MINUTOS_REINTENTO_CORREO=10
# Dirección de la aplicación (para los enlaces de contraseña que salen por correo) y remitente de esos correos
FRONTEND_URL=http://localhost:5173
# Dirección pública de la API: de ahí toma el correo el escudo si no se define LOGO_CORREO_URL. Debe ser alcanzable
# desde Internet (el servidor desplegado).
API_PUBLICA_URL=http://localhost:3000
# Escudo del encabezado de los correos: por defecto, el que la universidad publica en su sitio.
# LOGO_CORREO_URL=https://www.unicesmag.edu.co/recursos/uploads/2022/04/Escudos_2-2-300x300.png
# REMITENTE_CUENTAS=revistaeducacionpedagogia@gmail.com

# Respaldo de la base
# PG_DUMP_RUTA=C:\Program Files\PostgreSQL\18\bin\pg_dump.exe
# RESPALDOS_A_CONSERVAR=14
